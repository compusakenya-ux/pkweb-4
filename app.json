/**
 * ============================================================================
 * SENA — 3D Spatial Interactive Engine, 4K Clarity Loupe & Meta WhatsApp Bot
 * ============================================================================
 */

document.addEventListener('DOMContentLoaded', () => {
  initWebGLScene();
  init3DTiltAndStage();
  initOpticalClarityLoupe();
  initMetaWhatsAppBot();
  initKdpaModal();
  fetchGcpAndMetaStatus();
});

/**
 * 1. Three.js 3D WebGL Spatial Telemetry & Particle Scene
 */
function initWebGLScene() {
  const canvas = document.getElementById('webgl-canvas');
  if (!canvas || typeof THREE === 'undefined') return;

  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(
    60,
    window.innerWidth / window.innerHeight,
    0.1,
    1000
  );
  camera.position.set(0, 12, 42);

  const renderer = new THREE.WebGLRenderer({
    canvas,
    alpha: true,
    antialias: true
  });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

  // 3D Telemetry Grid Helper representing Mombasa E-Fleet Network
  const gridHelper = new THREE.GridHelper(160, 48, 0x38bdf8, 0x1e293b);
  gridHelper.position.y = -12;
  gridHelper.material.transparent = true;
  gridHelper.material.opacity = 0.25;
  scene.add(gridHelper);

  // Floating 3D Energy Particles (Amber #ff9e5e & Cyan #38bdf8)
  const particleCount = 260;
  const positions = new Float32Array(particleCount * 3);
  const colors = new Float32Array(particleCount * 3);

  const amberColor = new THREE.Color(0xff9e5e);
  const cyanColor = new THREE.Color(0x38bdf8);

  for (let i = 0; i < particleCount; i++) {
    positions[i * 3] = (Math.random() - 0.5) * 120;
    positions[i * 3 + 1] = (Math.random() - 0.5) * 65;
    positions[i * 3 + 2] = (Math.random() - 0.5) * 80;

    const mixedColor = Math.random() > 0.45 ? amberColor : cyanColor;
    colors[i * 3] = mixedColor.r;
    colors[i * 3 + 1] = mixedColor.g;
    colors[i * 3 + 2] = mixedColor.b;
  }

  const geometry = new THREE.BufferGeometry();
  geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
  geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));

  const material = new THREE.PointsMaterial({
    size: 0.55,
    vertexColors: true,
    transparent: true,
    opacity: 0.75
  });

  const particleCloud = new THREE.Points(geometry, material);
  scene.add(particleCloud);

  // Wireframe 3D Torus representing SENA Hyper-Fluid Core
  const torusGeo = new THREE.TorusKnotGeometry(9, 1.8, 110, 16);
  const torusMat = new THREE.MeshBasicMaterial({
    color: 0x38bdf8,
    wireframe: true,
    transparent: true,
    opacity: 0.06
  });
  const torusMesh = new THREE.Mesh(torusGeo, torusMat);
  torusMesh.position.set(18, 4, -18);
  scene.add(torusMesh);

  let targetX = 0;
  let targetY = 0;

  window.addEventListener('pointermove', (e) => {
    targetX = (e.clientX / window.innerWidth - 0.5) * 6;
    targetY = (e.clientY / window.innerHeight - 0.5) * 4;
  });

  window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
  });

  function animate() {
    requestAnimationFrame(animate);
    particleCloud.rotation.y += 0.0009;
    gridHelper.position.z = (Date.now() * 0.008) % 3.33;
    torusMesh.rotation.x += 0.003;
    torusMesh.rotation.y += 0.004;

    camera.position.x += (targetX - camera.position.x) * 0.04;
    camera.position.y += (12 - targetY - camera.position.y) * 0.04;
    camera.lookAt(0, 0, 0);

    renderer.render(scene, camera);
  }

  animate();
}

/**
 * 2. Interactive 3D Holographic Stage & 3D Tilt Cards
 */
function init3DTiltAndStage() {
  const heroRig = document.getElementById('hero-holo-rig');
  const heroGlare = document.getElementById('hero-holo-glare');
  const heroMainImg = document.getElementById('hero-stage-main-img');
  const heroStageChip = document.getElementById('hero-stage-chip');
  const stageTabs = document.querySelectorAll('.stage-mode-tabs .stage-tab');

  // Switch active 3D photo on Hero Stage
  stageTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      stageTabs.forEach((t) => t.classList.remove('active'));
      tab.classList.add('active');
      const imgUrl = tab.getAttribute('data-stage-img');
      const label = tab.getAttribute('data-stage-label');
      if (heroMainImg && imgUrl) {
        heroMainImg.src = imgUrl;
        heroMainImg.style.objectFit = imgUrl.includes('mobile-splash') ? 'contain' : 'cover';
      }
      if (heroStageChip && label) {
        heroStageChip.textContent = `⚡ ${label}`;
      }
    });
  });

  // Hero 3D Rig interactive tilt
  if (heroRig) {
    heroRig.addEventListener('pointermove', (e) => {
      const rect = heroRig.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;

      const rotateX = ((y - centerY) / centerY) * -11;
      const rotateY = ((x - centerX) / centerX) * 13;

      heroRig.classList.remove('auto-orbit');
      heroRig.style.transform = `rotateX(${rotateX.toFixed(2)}deg) rotateY(${rotateY.toFixed(2)}deg)`;

      if (heroGlare) {
        const glareX = (x / rect.width) * 100;
        const glareY = (y / rect.height) * 100;
        heroGlare.style.setProperty('--glare-x', `${glareX}%`);
        heroGlare.style.setProperty('--glare-y', `${glareY}%`);
      }
    });

    heroRig.addEventListener('pointerleave', () => {
      heroRig.style.transform = 'rotateX(0deg) rotateY(0deg)';
      const orbitBtn = document.getElementById('toggle-orbit-btn');
      if (orbitBtn && orbitBtn.classList.contains('active')) {
        heroRig.classList.add('auto-orbit');
      }
    });
  }

  // 3-Column 3D Cards interactive tilt
  const tiltCards = document.querySelectorAll('.js-tilt-card');
  tiltCards.forEach((card) => {
    card.addEventListener('pointermove', (e) => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const rotateX = ((y - rect.height / 2) / (rect.height / 2)) * -10;
      const rotateY = ((x - rect.width / 2) / (rect.width / 2)) * 10;
      card.style.transform = `rotateX(${rotateX.toFixed(2)}deg) rotateY(${rotateY.toFixed(2)}deg)`;
    });

    card.addEventListener('pointerleave', () => {
      card.style.transform = 'rotateX(0deg) rotateY(0deg)';
    });
  });

  // Clarity Lab Toolbar Controls
  const depthSlider = document.getElementById('depth-slider');
  const depthValLabel = document.getElementById('depth-val-label');
  if (depthSlider) {
    depthSlider.addEventListener('input', (e) => {
      const val = e.target.value;
      document.documentElement.style.setProperty('--depth-extrusion', `${val}px`);
      if (depthValLabel) depthValLabel.textContent = `${val}px`;
    });
  }

  const claritySlider = document.getElementById('clarity-slider');
  const clarityValLabel = document.getElementById('clarity-val-label');
  if (claritySlider) {
    claritySlider.addEventListener('input', (e) => {
      const pct = parseInt(e.target.value, 10);
      const contrast = (pct / 100).toFixed(2);
      const saturate = (1 + (pct - 100) / 140).toFixed(2);
      document.documentElement.style.setProperty('--clarity-contrast', contrast);
      document.documentElement.style.setProperty('--clarity-saturate', saturate);
      if (clarityValLabel) clarityValLabel.textContent = `${pct}% HDR`;
    });
  }

  const toggleLidarBtn = document.getElementById('toggle-lidar-btn');
  if (toggleLidarBtn) {
    toggleLidarBtn.addEventListener('click', () => {
      const active = document.body.classList.toggle('lidar-mode');
      toggleLidarBtn.classList.toggle('active', active);
      toggleLidarBtn.textContent = active
        ? '📡 LiDAR Telemetry Mesh: ON'
        : '📡 LiDAR Telemetry Mesh: OFF';
    });
  }

  const toggleOrbitBtn = document.getElementById('toggle-orbit-btn');
  if (toggleOrbitBtn && heroRig) {
    toggleOrbitBtn.addEventListener('click', () => {
      const active = heroRig.classList.toggle('auto-orbit');
      toggleOrbitBtn.classList.toggle('active', active);
      toggleOrbitBtn.textContent = active ? '🔄 3D Auto-Orbit: ON' : '🔄 3D Auto-Orbit: OFF';
    });
  }
}

/**
 * 3. 4K Optical Image Clarity Magnifier Loupe
 */
function initOpticalClarityLoupe() {
  const viewports = document.querySelectorAll('.js-loupe-viewport');
  const toggleLoupeBtn = document.getElementById('toggle-loupe-btn');
  let loupeEnabled = true;

  if (toggleLoupeBtn) {
    toggleLoupeBtn.addEventListener('click', () => {
      loupeEnabled = !loupeEnabled;
      toggleLoupeBtn.classList.toggle('active', loupeEnabled);
      toggleLoupeBtn.textContent = loupeEnabled
        ? '🔍 4K Clarity Loupe: ON'
        : '🔍 4K Clarity Loupe: OFF';

      document.querySelectorAll('.optical-loupe').forEach((l) => {
        l.classList.toggle('enabled', loupeEnabled);
      });
    });
  }

  viewports.forEach((vp) => {
    const imgUrl = vp.getAttribute('data-img');
    const loupe = vp.querySelector('.optical-loupe');
    if (!loupe || !imgUrl) return;

    loupe.style.backgroundImage = `url('${imgUrl}')`;
    loupe.style.backgroundSize = '260% 260%';

    vp.addEventListener('pointermove', (e) => {
      if (!loupeEnabled) return;
      const rect = vp.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const xPct = Math.max(0, Math.min(100, (x / rect.width) * 100));
      const yPct = Math.max(0, Math.min(100, (y / rect.height) * 100));

      loupe.style.left = `${x}px`;
      loupe.style.top = `${y}px`;
      loupe.style.backgroundPosition = `${xPct}% ${yPct}%`;
    });
  });
}

/**
 * 4. Meta Business Account WhatsApp Integration Chatbot
 */
function initMetaWhatsAppBot() {
  const drawer = document.getElementById('whatsapp-drawer');
  const fabBtn = document.getElementById('whatsapp-fab-btn');
  const navBtn = document.getElementById('nav-whatsapp-btn');
  const heroBtn = document.getElementById('hero-whatsapp-btn');
  const closeBtn = document.getElementById('wa-close-btn');
  const configBtn = document.getElementById('wa-toggle-config-btn');
  const configPanel = document.getElementById('wa-meta-config-panel');
  const saveConfigBtn = document.getElementById('save-meta-config-btn');

  const bizIdInput = document.getElementById('meta-biz-id-input');
  const phoneIdInput = document.getElementById('meta-phone-id-input');
  const waNumInput = document.getElementById('meta-wa-num-input');
  const directLink = document.getElementById('wa-direct-external-link');
  const headerSub = document.getElementById('wa-header-sub');

  const messagesEl = document.getElementById('wa-messages');
  const chatForm = document.getElementById('wa-chat-form');
  const chatInput = document.getElementById('wa-input');
  const quickChipsContainer = document.getElementById('wa-quick-chips');

  // Restore saved Meta Business Account config if set in browser
  const savedConfig = JSON.parse(localStorage.getItem('sena_meta_biz_config') || '{}');
  if (savedConfig.businessAccountId && bizIdInput) bizIdInput.value = savedConfig.businessAccountId;
  if (savedConfig.phoneNumberId && phoneIdInput) phoneIdInput.value = savedConfig.phoneNumberId;
  if (savedConfig.displayNumber && waNumInput) waNumInput.value = savedConfig.displayNumber;

  function updateDirectWaLink(lastMsg = 'Habari SENA! I would like to book an electric ride in Mombasa.') {
    const num = (waNumInput?.value || '254700736200').replace(/[^0-9]/g, '');
    const bizId = bizIdInput?.value || '104829104928174';
    if (directLink) {
      directLink.href = `https://wa.me/${num}?text=${encodeURIComponent(`${lastMsg} [Meta Business ID: ${bizId}]`)}`;
    }
    if (headerSub) {
      headerSub.textContent = `Meta Business ID: ${bizId} • Online`;
    }
  }

  updateDirectWaLink();

  function openDrawer() {
    if (drawer) drawer.classList.add('open');
  }

  [fabBtn, navBtn, heroBtn].forEach((btn) => {
    if (btn) btn.addEventListener('click', openDrawer);
  });

  if (closeBtn && drawer) {
    closeBtn.addEventListener('click', () => drawer.classList.remove('open'));
  }

  if (configBtn && configPanel) {
    configBtn.addEventListener('click', () => configPanel.classList.toggle('visible'));
  }

  if (saveConfigBtn) {
    saveConfigBtn.addEventListener('click', () => {
      const cfg = {
        businessAccountId: bizIdInput?.value.trim() || '104829104928174',
        phoneNumberId: phoneIdInput?.value.trim() || '118492019482719',
        displayNumber: waNumInput?.value.trim() || '254700736200'
      };
      localStorage.setItem('sena_meta_biz_config', JSON.stringify(cfg));
      updateDirectWaLink();
      fetchGcpAndMetaStatus();
      if (configPanel) configPanel.classList.remove('visible');
      appendMessage(
        'bot',
        `✅ Linked to Meta Business Account ID: ${cfg.businessAccountId} (Phone ID: ${cfg.phoneNumberId}).`
      );
    });
  }

  function appendMessage(role, text, waMeUrl = null) {
    if (!messagesEl) return;
    const msgDiv = document.createElement('div');
    msgDiv.className = `wa-msg ${role}`;
    msgDiv.textContent = text;

    if (waMeUrl && role === 'bot') {
      const linkWrap = document.createElement('div');
      linkWrap.style.marginTop = '0.55rem';
      const a = document.createElement('a');
      a.href = waMeUrl;
      a.target = '_blank';
      a.rel = 'noopener noreferrer';
      a.style.color = '#4ade80';
      a.style.fontWeight = '700';
      a.style.fontSize = '0.76rem';
      a.style.textDecoration = 'none';
      a.textContent = '📲 Continue in Official WhatsApp App ↗';
      linkWrap.appendChild(a);
      msgDiv.appendChild(linkWrap);
    }

    messagesEl.appendChild(msgDiv);
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  async function sendToMetaBot(messageText) {
    if (!messageText.trim()) return;
    openDrawer();
    appendMessage('user', messageText);
    updateDirectWaLink(messageText);

    try {
      const res = await fetch('/api/whatsapp/send', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          message: messageText,
          metaAccountOverride: {
            businessAccountId: bizIdInput?.value.trim(),
            phoneNumberId: phoneIdInput?.value.trim(),
            displayNumber: waNumInput?.value.trim()
          }
        })
      });

      const data = await res.json();
      if (data && data.reply) {
        appendMessage('bot', data.reply, data.metaBusiness?.waMeDirectUrl);
      } else {
        appendMessage('bot', 'Habari! Tap below to connect with SENA Dispatch on WhatsApp.');
      }
    } catch (_err) {
      const num = (waNumInput?.value || '254700736200').replace(/[^0-9]/g, '');
      const bizId = bizIdInput?.value || '104829104928174';
      const fallbackUrl = `https://wa.me/${num}?text=${encodeURIComponent(
        `Habari SENA! [Meta Business ID: ${bizId}] ${messageText}`
      )}`;
      const lower = messageText.toLowerCase();
      let smartReply =
        '⚡ SENA Mobility Dispatch Ready (Mombasa)!\n' +
        '• Standard E-Bike (SDR FR-C011): Base KES 40 • Typical KES 132\n' +
        '• 3-Seater E-Tuk-Tuk: Base KES 80 • 210 KM Range\n' +
        'Tap below to continue in your official WhatsApp app linked to our Meta Business Account.';

      if (lower.includes('bike') || lower.includes('132')) {
        smartReply =
          '🏍️ SENA Standard E-Bike (SDR FR-C011)\n' +
          '• Upfront Fare Clarity: Base KES 40 | City Center ↔ Nyali ~KES 132\n' +
          '• 92% Battery Telemetry | < 90s Mombasa Dispatch.\n' +
          'Tap below to send your pickup pin on WhatsApp.';
      } else if (lower.includes('tuk') || lower.includes('3-seater') || lower.includes('3 seater')) {
        smartReply =
          '🛺 SENA 3-Seater Electric Tuk-Tuk (E-TU TUK 01)\n' +
          '• Upfront Fare: Base KES 80 (Up to 3 Pax) | ~KES 240\n' +
          '• 87% Battery | 210 KM Range | Panoramic Glass Cabin.\n' +
          'Tap below to confirm your 3-Seater pickup on WhatsApp.';
      } else if (lower.includes('kdpa') || lower.includes('privacy') || lower.includes('2019')) {
        smartReply =
          '🛡️ Kenya Data Protection Act, 2019 (No. 24 of 2019)\n' +
          'Poughkeepsie Limited (operating SENA Transit) encrypts all rider telemetry & Meta Business chats on Google Cloud Platform in compliance with ODPC Kenya regulations.';
      } else if (lower.includes('contact') || lower.includes('poughkeepsie') || lower.includes('facebook') || lower.includes('email')) {
        smartReply =
          '🏢 Poughkeepsie Limited — Transport Ecosystem Hub\n' +
          '• Product: SENA Transit (Twende Kazi)\n' +
          '• Tel: +254 700 736 200\n' +
          '• Email: info@poughkeepsie.co.ke\n' +
          '• Facebook: Poughkeepsie Limited\n' +
          'Tap below to chat directly with Poughkeepsie Limited on WhatsApp.';
      }

      appendMessage('bot', smartReply, fallbackUrl);
    }
  }

  if (chatForm && chatInput) {
    chatForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const val = chatInput.value;
      chatInput.value = '';
      sendToMetaBot(val);
    });
  }

  if (quickChipsContainer) {
    quickChipsContainer.addEventListener('click', (e) => {
      const chip = e.target.closest('.wa-chip');
      if (chip) {
        const msg = chip.getAttribute('data-msg');
        if (msg) sendToMetaBot(msg);
      }
    });
  }

  document.querySelectorAll('.js-quick-wa-trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const prompt = btn.getAttribute('data-wa-prompt') || 'Book Standard Bike (KES 132)';
      sendToMetaBot(prompt);
    });
  });
}

/**
 * 5. Kenya Data Protection Act 2019 Modal
 */
function initKdpaModal() {
  const modal = document.getElementById('kdpa-modal');
  const openBtn = document.getElementById('open-kdpa-modal-btn');
  const closeBtn = document.getElementById('close-kdpa-modal-btn');

  if (openBtn && modal) {
    openBtn.addEventListener('click', () => modal.classList.add('open'));
  }
  if (closeBtn && modal) {
    closeBtn.addEventListener('click', () => modal.classList.remove('open'));
  }
  if (modal) {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.classList.remove('open');
    });
  }
}

/**
 * 6. Fetch Live GCP & Meta Business Account Telemetry
 */
async function fetchGcpAndMetaStatus() {
  const statusBox = document.getElementById('gcp-live-status-box');
  if (!statusBox) return;

  try {
    const res = await fetch('/api/config/status');
    if (!res.ok) throw new Error('Static preview mode');
    const data = await res.json();
    statusBox.textContent = JSON.stringify(data, null, 2);
  } catch (_err) {
    const savedCfg = JSON.parse(localStorage.getItem('sena_meta_biz_config') || '{}');
    statusBox.textContent = JSON.stringify(
      {
        status: 'healthy',
        company: 'Poughkeepsie Limited',
        flagshipProduct: 'SENA Transit (Poughkeepsie Transport Ecosystem)',
        contact: {
          tel: '+254700736200',
          email: 'info@poughkeepsie.co.ke',
          facebook: 'Poughkeepsie Limited (https://www.facebook.com/search/top?q=Poughkeepsie%20Limited)'
        },
        platform: 'Google Cloud Platform (Cloud Run + Cloud Storage)',
        gcp: {
          projectId: 'sena-mobility-ke-prod',
          region: 'africa-south1',
          gcsBucket: 'sena-mobility-3d-assets-prod',
          cloudRunService: 'sena-3d-landing',
          iacTemplates: ['Dockerfile', 'cloudbuild.yaml', 'app.yaml', 'infra/main.tf']
        },
        metaBusiness: {
          graphApiVersion: 'v21.0',
          businessAccountId: savedCfg.businessAccountId || '104829104928174',
          wabaId: '109482716492810',
          phoneNumberId: savedCfg.phoneNumberId || '118492019482719',
          displayNumber: savedCfg.displayNumber || '254700736200',
          webhookEndpoint: '/api/whatsapp/webhook'
        },
        compliance: {
          framework: 'Kenya Data Protection Act, 2019 (No. 24 of 2019)',
          kenyaLawUrl: 'http://kenyalaw.org:8181/exist/kenyalex/actview.xql?actid=No.%2024%20of%202019',
          odpcPortal: 'https://www.odpc.go.ke/data-protection-act/'
        }
      },
      null,
      2
    );
  }
}
